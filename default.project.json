{
  "name": "RECALL",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "Packages": {
        "$path": "Packages"
      },
      "Shared": {
        "$path": "src/shared"
      },
      "Assets": {
        "$className": "Folder"
      }
    },

    "ReplicatedFirst": {
      "Loading": {
        "$path": "src/loading"
      }
    },

    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },

    "ServerStorage": {
      "ServerAssets": {
        "$className": "Folder"
      }
    },

    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      },
      "StarterCharacterScripts": {
        "$className": "Folder"
      }
    },

    "StarterGui": {
      "UI": {
        "$path": "src/ui"
      }
    },

    "Workspace": {
      "$properties": {
        "FilteringEnabled": true
      }
    },

    "Lighting": {
      "$properties": {
        "Ambient": [0.1, 0.1, 0.12],
        "Brightness": 1.5,
        "GlobalShadows": true,
        "Outlines": false,
        "Technology": "Future"
      }
    },

    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}
